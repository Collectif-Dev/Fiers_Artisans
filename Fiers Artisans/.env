# Copier en .env et adapter API_HOST à votre IP locale (ipconfig → IPv4)
# Téléphone physique : utiliser l'IP LAN du PC (ex: 192.168.137.237)
# Emulateur Android : vous pouvez utiliser 10.0.2.2
API_HOST=192.168.1.18
# Optionnel: laisser vide pour utiliser automatiquement l'hôte du navigateur
API_HOST_WEB=
# Optionnel: utilisé seulement si API_HOST est vide (émulateur Android)
API_HOST_MOBILE=10.0.2.2
API_PORT=3000
API_SCHEME=http
WS_SCHEME=ws
API_BASE_PATH=/api/v1
