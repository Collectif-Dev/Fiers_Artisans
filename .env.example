# ══════════════════════════════════════════════════════════════════════
# Fiers Artisans — Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs marquées "change_me"
# ══════════════════════════════════════════════════════════════════════
#
# 🛡️  Secrets : toutes les valeurs "change_me_*" DOIVENT être remplacées.
# En production, le serveur refusera de démarrer si elles ne sont pas changées.
#
# 🌐 SERVICES WEB DISPONIBLES (localhost):
#    • Admin Web (Next.js)      → http://localhost:3002
#    • API Backend (REST)       → http://localhost:3000/api/v1
#    • Grafana (Monitoring)     → http://localhost:3001
#    • MinIO Console (Storage)  → http://localhost:9003
#    • Prometheus (Metrics)     → http://localhost:9090
#    • Portainer (Docker mgmt)  → https://localhost:9443
#
# 📱 Frontend Flutter : les variables réseau sont dans
#    Fiers Artisans/.env (API_HOST, API_PORT, etc.).
#    Voir la section "Flutter" en bas de ce fichier.
# ══════════════════════════════════════════════════════════════════════

# ── PostgreSQL ─────────────────────────────────────────────────────────
# En dev local : host=localhost, port=5434 (port hôte Docker)
# En Docker    : host=postgres, port=5432 (port interne)
POSTGRES_USER=fiers_artisans
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=fiers_artisans
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
# Optionnel: URL complète prioritaire si définie
DATABASE_POSTGRES_URL=

# ── MongoDB ────────────────────────────────────────────────────────────
# En dev local : host=localhost, port=27018 (port hôte Docker)
# En Docker    : host=mongodb, port=27017 (port interne)
MONGO_USER=fiers_artisans
MONGO_PASSWORD=change_me_mongo
MONGO_DB=fiers_artisans
MONGO_HOST=localhost
MONGO_PORT=27018
# Optionnel: URL complète prioritaire si définie
DATABASE_MONGO_URL=

# ── Redis ──────────────────────────────────────────────────────────────
# En dev local : host=localhost, port=6380 (port hôte Docker)
# En Docker    : host=redis, port=6379 (port interne)
REDIS_PASSWORD=change_me_redis
REDIS_HOST=localhost
REDIS_PORT=6380
# Optionnel: URL complète prioritaire si définie
REDIS_URL=

# ── MinIO (S3-compatible) ──────────────────────────────────────────────
# En dev local : endpoint=localhost, port=9002 (port hôte Docker)
# En Docker    : endpoint=minio, port=9000 (port interne)
MINIO_ACCESS_KEY=change_me_minio_access
MINIO_SECRET_KEY=change_me_minio_secret
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_USE_SSL=false
# Endpoints publics (utiles en dev Docker)
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9002
MINIO_PUBLIC_USE_SSL=false
MINIO_BUCKET_PORTFOLIO=portfolio
MINIO_BUCKET_DOCUMENTS=documents
MINIO_BUCKET_MEDIA=media
MINIO_PAYMENT_PROOF_BUCKET=payment-proofs
MINIO_PROFILES_BUCKET=profiles

# ── JWT ────────────────────────────────────────────────────────────────
# Secret DOIT contenir au moins 32 caractères en production
JWT_SECRET=change_me_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# ── WhatsApp Business Cloud API (Meta) ─────────────────────────────────
# Provider OTP principal. Laisser API_TOKEN vide en dev → log OTP en console.
WHATSAPP_PROVIDER_ENABLED=true
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=fiers_artisans_otp

# ── SMS Fallback (Twilio) — Désactivé par défaut ──────────────────────
SMS_PROVIDER_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── OTP Configuration ────────────────────────────────────────────────
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=3
OTP_BLOCK_DURATION_SECONDS=900
PIN_MAX_ATTEMPTS=5
PIN_BLOCK_DURATION_SECONDS=900
PIN_ATTEMPT_WINDOW_SECONDS=900
# Seed admin (scripts backend/src/database/seeds)
ADMIN_PHONE=0700000000
ADMIN_PIN=12345

# ── OTP Dev Inspector (désactivé par défaut) ─────────────────────────
# Active un endpoint GET /api/v1/dev/otp/latest consultable en navigateur.
# NE JAMAIS activer en production.
OTP_DEV_INSPECTOR=false
OTP_DEV_KEY=change_me_dev_key

# ── WebSocket CORS — Origines autorisées (Groupe 2 Security) ──────────
# Origines comma-separated autorisées pour les WebSockets (chat, map-visibility).
# Inclure toutes les URLs de production et développement.
# Fallback: https://fiers-artisans.ci
ALLOWED_ORIGINS=https://fiers-artisans.ci,http://localhost:3002

# ── Wave CI (Paiement) ────────────────────────────────────────────────
WAVE_API_URL=https://api.wave.com/v1
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=change_me_wave_webhook
WAVE_MERCHANT_ID=

# ── Paiement manuel (MVP Phase 1) ─────────────────────────────────────
PAYMENT_MANUAL_AMOUNT_FCFA=5000
PAYMENT_MANUAL_EXPIRY_HOURS=72
PAYMENT_ORANGE_RECIPIENT=0703063570
PAYMENT_MTN_RECIPIENT=0503265984
PAYMENT_WAVE_RECIPIENT=0703063570
PAYMENT_MANUAL_UPLOADS_PER_DAY_LIMIT=12
PAYMENT_MANUAL_SUBMIT_BURST_LIMIT=5
PAYMENT_MANUAL_SUBMIT_BURST_TTL_SECONDS=300
PAYMENT_MANUAL_EXPIRE_BATCH_LOOPS=30
PAYMENT_MANUAL_DISABLE_REDIS_RATE_LIMIT=false

# ── Firebase Cloud Messaging ──────────────────────────────────────────
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=

# ── App (NestJS) ──────────────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000
APP_HOST=0.0.0.0
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
CORS_ALLOW_LAN=true
CORS_LAN_PORTS=3000,3001,3002,5050,8080

# ── Admin Web (Next.js) ───────────────────────────────────────────────
# En prod derrière Nginx, utiliser un chemin relatif pour éviter CORS.
ADMIN_WEB_API_URL=/api/v1
# Utilisés en dev si ADMIN_WEB_API_URL est vide.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_API_PORT=3000
NEXT_PUBLIC_API_BASE_PATH=/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=fr

# ── Rate Limiting ─────────────────────────────────────────────────────
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=30

# ── Monitoring (Grafana) ──────────────────────────────────────────────
# Interface: http://localhost:3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_grafana

# ── Prometheus ─────────────────────────────────────────────────────────
# Interface: http://localhost:9090
# Note: Pas d'authentification par défaut (lecture seule)
PROMETHEUS_ENABLED=true

# ── Portainer (Gestion Docker) ─────────────────────────────────────────
# Interface: https://localhost:9443
# Première connexion: création du compte admin
PORTAINER_ADMIN_USER=admin
PORTAINER_ADMIN_PASSWORD=change_me_portainer

# ══════════════════════════════════════════════════════════════════════
# 🔐 INTERFACES WEB SERVICES (Référence pour les développeurs)
# ══════════════════════════════════════════════════════════════════════
#
# Tous les services avec interface web accessible localement:
#
# ✅ Service              | URL                      | Authentification
# ─────────────────────────┼──────────────────────────┼──────────────────────────
# Grafana                 | http://localhost:3001   | username=admin, password=...
# MinIO Console           | http://localhost:9003   | access_key=..., secret=...
# Portainer               | https://localhost:9443  | admin/password
# Prometheus              | http://localhost:9090   | (No auth)
# Admin Web (Next.js)     | http://localhost:3002   | (JWT via API)
# API Backend (REST)      | http://localhost:3000   | (JWT required)
#
# Identifiants MinIO:
MINIO_CONSOLE_URL=http://localhost:9003
MINIO_CONSOLE_ACCESS_KEY=change_me_minio_access
MINIO_CONSOLE_SECRET_KEY=change_me_minio_secret
#
# ══════════════════════════════════════════════════════════════════════
# 📱 Flutter — Configuration réseau
# ══════════════════════════════════════════════════════════════════════
#
# Le frontend Flutter lit ses variables depuis : Fiers Artisans/.env
# Voir Fiers Artisans/.env.example pour le template.
#
# Pour changer l'IP backend :
#   1. Ouvrir Fiers Artisans/.env
#   2. Modifier API_HOST=votre_ip
#   3. Hot restart (R) ou relancer flutter run
# ══════════════════════════════════════════════════════════════════════
